#include <stdio.h>
#include <string.h>

int main() {
    char email[100], copy[100], formatted[150] = "Email: ";

    printf("Enter email: ");
    scanf("%s", email);

    strcpy(copy, email);

    char *ptr = strchr(copy, '@');

    if (ptr == NULL) {
        printf("Invalid email (no @ found)\n");
        return 0;
    }

    printf("Domain: %s\n", ptr + 1);

    if (strstr(ptr + 1, ".") == NULL) {
        printf("Invalid domain (no . found)\n");
    }

    strcat(formatted, copy);
    printf("%s\n", formatted);

    return 0;
}
