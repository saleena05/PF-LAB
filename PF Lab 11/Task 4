#include <stdio.h>
#include <string.h>

struct Patient
{
    char name[50];
    int age;
    char bloodType[5];
    int patientID;
    char diagnosis[100];
};

void displayAll(struct Patient p[], int n)
{
    printf("\n--- Patient Records ---\n");
    for (int i = 0; i < n; i++)
    {
        printf("ID: %d\nName: %sAge: %d\nBlood Type: %s\nDiagnosis: %s\n\n",
               p[i].patientID, p[i].name, p[i].age, p[i].bloodType, p[i].diagnosis);
    }
}

void searchByID(struct Patient p[], int n, int id)
{
    for (int i = 0; i < n; i++)
    {
        if (p[i].patientID == id)
        {
            printf("\nPatient Found:\n");
            printf("Name: %sAge: %d\nBlood Type: %s\nDiagnosis: %s\n",
                   p[i].name, p[i].age, p[i].bloodType, p[i].diagnosis);
            return;
        }
    }
    printf("Patient not found\n");
}

int main()
{
    struct Patient p[5];

    for (int i = 0; i < 5; i++)
    {
        printf("\nEnter details for patient %d\n", i + 1);

        printf("Name: ");
        getchar(); // keep as per your structure
        fgets(p[i].name, sizeof(p[i].name), stdin);
        p[i].name[strcspn(p[i].name, "\n")] = 0; // remove newline

        printf("Age: ");
        scanf("%d", &p[i].age);

        printf("Blood Type: ");
        scanf("%s", p[i].bloodType);

        printf("Patient ID: ");
        scanf("%d", &p[i].patientID);

        printf("Diagnosis: ");
        getchar();
        fgets(p[i].diagnosis, sizeof(p[i].diagnosis), stdin);
        p[i].diagnosis[strcspn(p[i].diagnosis, "\n")] = 0;
    }

    displayAll(p, 5);

    int id;
    printf("Enter ID to search: ");
    scanf("%d", &id);

    searchByID(p, 5, id);

    return 0;
}
