#include <stdio.h>

float applyDiscount(float price, int tier);
void printInvoice(float original, float discounted);

int main() {
    float price, discounted;
    int tier;

    printf("Enter price and membership tier (1-4): ");
    scanf("%f %d", &price, &tier);

    discounted = applyDiscount(price, tier);
    printInvoice(price, discounted);

    return 0;
}

float applyDiscount(float price, int tier) {
    if (tier == 1)
        return price * 0.95;
    else if (tier == 2)
        return price * 0.90;
    else if (tier == 3)
        return price * 0.80;
    else if (tier == 4)
        return price * 0.70;
    else
        return price;
}

void printInvoice(float original, float discounted) {
    float discount = original - discounted;
    float delivery = 0;

    if (discounted < 2000)
        delivery = 150;

    printf("\n--- Invoice ---\n");
    printf("Original: %.2f\n", original);
    printf("Discount: %.2f\n", discount);
    printf("Delivery: %.2f\n", delivery);
    printf("Total: %.2f\n", discounted + delivery);
}
